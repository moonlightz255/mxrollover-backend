// test-db-connection.js
const dns = require('dns');
const net = require('net');
const fs = require('fs');
const mysql = require('mysql2/promise');

const host = process.env.DB_HOST;
const port = parseInt(process.env.DB_PORT || '11292', 10);

async function tcpAndMysqlCheck() {
  console.log('DNS/TCP test: host=', host, 'port=', port);

  if (!host) {
    console.error('DB_HOST not set');
    process.exit(1);
  }

  dns.lookup(host, (err, address) => {
    console.log('dns.lookup result:', { err: err ? err.message : null, address });
  });

  const sock = net.createConnection({ host, port, timeout: 7000 }, () => {
    console.log('TCP connect: success to', `${host}:${port}`);
    sock.end();
  });
  sock.on('error', (e) => console.log('TCP connect error:', e.message));
  sock.on('timeout', () => { console.log('TCP connect timeout'); sock.destroy(); });

  // Optional: try a short mysql connect using ssl if needed
  try {
    const ssl = {};
    if (process.env.DB_CA_PATH) {
      ssl.ca = fs.readFileSync(process.env.DB_CA_PATH, 'utf8');
      ssl.rejectUnauthorized = true;
    }
    const conn = await mysql.createConnection({
      host,
      port,
      user: process.env.DB_USER,
      password: process.env.DB_PASSWORD,
      database: process.env.DB_NAME,
      ssl: Object.keys(ssl).length ? ssl : undefined,
      connectTimeout: 7000
    });
    console.log('MySQL connection: success (handshake)');
    await conn.end();
  } catch (e) {
    console.log('MySQL connect error:', e.message);
  }
}

tcpAndMysqlCheck();
